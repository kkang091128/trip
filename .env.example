# KoreaTrip 지도 및 외부 서비스 환경변수 설정 가이드
# 실제 환경변수 파일(.env)에 아래 키를 복사하여 값을 입력하세요.
# 주의: API 키는 소스 코드에 직접 하드코딩하지 않고 본 설정으로 관리합니다.

# ==========================================================
# 1. Leaflet 오픈 지도 타일 설정 (기본값: API 키 없이도 즉시 실제 지도 작동)
# ==========================================================
# 기본적으로 OpenStreetMap(OSM) 및 CartoDB Voyager 타일이 무키(Free)로 제공되어
# 별도의 API 키 없이도 대한민국 전국 지도, 줌/팬, 마커 클러스터링이 100% 정상 작동합니다.
DEFAULT_TILE_PROVIDER="openstreetmap" # 옵션: openstreetmap, cartodb, vworld

# ==========================================================
# 2. VWorld 국가공간정보포털 지도 API (선택 사항)
# 발급처: https://www.vworld.kr/
# 한국어 지명 및 행정구역 표기가 가장 정밀한 국토교통부 표준 지도 타일을 사용할 수 있습니다.
# ==========================================================
VWORLD_API_KEY=""

# ==========================================================
# 3. Kakao Maps API (선택 사항)
# 발급처: https://developers.kakao.com/
# ==========================================================
KAKAO_MAP_API_KEY=""

# ==========================================================
# 4. Naver Cloud Maps API (선택 사항)
# 발급처: https://www.ncloud.com/product/applicationService/maps
# ==========================================================
NAVER_MAP_CLIENT_ID=""

# ==========================================================
# 5. Google AdSense 클라이언트 ID (선택 사항)
# ==========================================================
ADSENSE_CLIENT_ID="ca-pub-0000000000000000"
